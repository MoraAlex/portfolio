# Section-level feature flags (build-time only; changing these requires a rebuild).
# Accepted values: "true" / "false" (case-insensitive). Unset falls back to the default shown below.

# Show/hide the GitHub activity section. Default: true
GITHUB_FF=true

# Show/hide the Featured Projects section. Default: true
FEATURED_PROJECTS_FF=true

# Show/hide the Blog section. Default: false
BLOG_FF=false
