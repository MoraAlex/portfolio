---
import { TECH_ICONS } from "../lib/techIcons";

const stack = [
  TECH_ICONS.go,
  TECH_ICONS.javascript,
  TECH_ICONS.typescript,
  TECH_ICONS.python,
  TECH_ICONS.react,
  TECH_ICONS.vue,
  TECH_ICONS.nodejs,
  TECH_ICONS.docker,
  TECH_ICONS.kubernetes,
  TECH_ICONS.kafka,
];
---

<section class="flex flex-col gap-8" id="stack">
  <h2 class="font-display-lg text-display-lg text-primary">Stack</h2>
  <p class="font-body-md text-body-md text-on-surface-variant">Technologies and tools I work with on a daily basis to build scalable and robust applications.</p>
  <div class="marquee pt-10">
    <div class="marquee-track">
      {
        [...stack, ...stack].map((icon) => (
          <div
            class="relative w-16 h-16 shrink-0 rounded-full border-2 border-surface-variant flex items-center justify-center bg-surface hover:border-primary transition-colors group"
            aria-label={icon.title}
          >
            <svg
              viewBox="0 0 24 24"
              class="w-8 h-8 transition-transform duration-200 group-hover:scale-110"
              style={`color: ${icon.hex}`}
              fill="currentColor"
            >
              <path d={icon.path} />
            </svg>
            <span
              role="tooltip"
              class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 scale-95 whitespace-nowrap rounded-md bg-inverse-surface px-2 py-1 text-xs font-medium text-inverse-on-surface opacity-0 transition-all duration-150 group-hover:scale-100 group-hover:opacity-100"
            >
              {icon.title}
            </span>
          </div>
        ))
      }
    </div>
  </div>
  <hr class="border-t border-outline-variant mt-12" />
</section>

<style>
  .marquee {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: max-content;
    animation: marquee-right 25s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
