---
---

<section class="flex flex-col gap-8" id="github">
  <h2 class="font-display-lg text-display-lg text-primary">Github</h2>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Terminal Panel -->
    <div class="bg-[#0D1117] rounded-xl p-4 md:p-6 border border-outline-variant font-mono text-sm shadow-level-2 flex flex-col gap-4">
      <div class="flex gap-2 mb-2">
        <div class="w-3 h-3 rounded-full bg-error"></div>
        <div class="w-3 h-3 rounded-full bg-[#FBBF24]"></div>
        <div class="w-3 h-3 rounded-full bg-tertiary-container"></div>
        <span class="text-xs text-outline ml-2">~/recent-commits</span>
      </div>
      <div class="text-[#8B949E]">
        $ git log --oneline -n 3<br />
        <span class="text-[#E6EDF3]">a1b2c3d</span> <span class="text-[#7EE787]">feat: optimize docker build cache - 2 days ago</span><br />
        <span class="text-[#E6EDF3]">f8e9d0a</span> <span class="text-[#7EE787]">fix: k8s ingress routing issue - 5 days ago</span><br />
        <span class="text-[#E6EDF3]">b4c5d6e</span> <span class="text-[#7EE787]">docs: update architecture diagrams - 1 week ago</span>
      </div>
    </div>
    <!-- Contribution Grid Panel -->
    <div class="bg-[#0D1117] rounded-xl p-4 md:p-6 border border-outline-variant shadow-level-2 flex flex-col justify-center items-center gap-4">
      <div class="text-[#E6EDF3] text-sm mb-2 w-full text-center">1,024 contributions in the last year</div>
      <!-- Mock Grid -->
      <div class="flex gap-1 overflow-x-auto w-full pb-2 opacity-80">
        <div class="flex flex-col gap-1"><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#006D32] rounded-sm"></div><div class="w-3 h-3 bg-[#26A641] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
        <div class="flex flex-col gap-1"><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#39D353] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#006D32] rounded-sm"></div></div>
        <div class="flex flex-col gap-1"><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#26A641] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
        <div class="flex flex-col gap-1"><div class="w-3 h-3 bg-[#39D353] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#006D32] rounded-sm"></div><div class="w-3 h-3 bg-[#26A641] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
        <div class="flex flex-col gap-1"><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#006D32] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
        <div class="flex-col gap-1 hidden sm:flex"><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div><div class="w-3 h-3 bg-[#26A641] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
        <div class="flex-col gap-1 hidden sm:flex"><div class="w-3 h-3 bg-[#39D353] rounded-sm"></div><div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div><div class="w-3 h-3 bg-[#006D32] rounded-sm"></div><div class="w-3 h-3 bg-[#26A641] rounded-sm"></div><div class="w-3 h-3 bg-[#161B22] rounded-sm"></div></div>
      </div>
      <div class="flex items-center gap-2 text-xs text-[#8B949E] mt-2">
        <span>Less</span>
        <div class="flex gap-1">
          <div class="w-3 h-3 bg-[#161B22] rounded-sm"></div>
          <div class="w-3 h-3 bg-[#0E4429] rounded-sm"></div>
          <div class="w-3 h-3 bg-[#006D32] rounded-sm"></div>
          <div class="w-3 h-3 bg-[#26A641] rounded-sm"></div>
          <div class="w-3 h-3 bg-[#39D353] rounded-sm"></div>
        </div>
        <span>More</span>
      </div>
    </div>
  </div>
  <div class="flex justify-center mt-4">
    <a class="font-label-md text-label-md text-primary hover:underline flex items-center gap-2" href="https://github.com/MoraAlex" target="_blank">
      https://github.com/MoraAlex <span class="material-symbols-outlined text-sm">open_in_new</span>
    </a>
  </div>
</section>
