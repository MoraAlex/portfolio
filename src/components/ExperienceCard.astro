---
import { highlightTech } from "../lib/highlightTech";
import { TECH_ICONS, type TechKey } from "../lib/techIcons";

interface Props {
  title: string;
  dateRange: string;
  description: string;
  achievements: string[];
  stack: string[];
}

const { title, dateRange, description, achievements, stack } = Astro.props;

function resolveTech(key: string) {
  const icon = TECH_ICONS[key as TechKey];
  return icon ? { icon, label: key } : { icon: null, label: key };
}
---

<div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant shadow-level-2 flex flex-col gap-4 relative overflow-hidden group hover:border-primary transition-colors">
  <div class="flex justify-between items-start flex-wrap gap-2">
    <h3 class="font-headline-sm text-headline-sm text-on-background">{title}</h3>
    <span class="font-label-md text-label-md text-on-surface-variant bg-surface-container px-3 py-1 rounded-full">{dateRange}</span>
  </div>
  <p class="font-body-md text-body-md text-on-surface-variant max-w-3xl" set:html={highlightTech(description)} />
  <ul class="list-disc list-inside font-body-sm text-body-sm text-on-surface-variant space-y-2 ml-2">
    {achievements.map((achievement) => <li set:html={highlightTech(achievement)} />)}
  </ul>
  <!-- Tech Stack Logos -->
  <div class="flex gap-2 mt-4 pt-4 border-t border-surface-container-highest">
    {
      stack.map(resolveTech).map(({ icon, label }) =>
        icon ? (
          <div
            class="group/tech relative w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center bg-surface-container-low"
            aria-label={icon.title}
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" style={`color: ${icon.hex}`} fill="currentColor">
              <path d={icon.path} />
            </svg>
            <span
              role="tooltip"
              class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 scale-95 whitespace-nowrap rounded-md bg-inverse-surface px-2 py-1 text-xs font-medium text-inverse-on-surface opacity-0 transition-all duration-150 group-hover/tech:scale-100 group-hover/tech:opacity-100"
            >
              {icon.title}
            </span>
          </div>
        ) : (
          <div class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center bg-surface-container-low text-xs text-on-surface-variant font-bold">
            {label}
          </div>
        )
      )
    }
  </div>
</div>
