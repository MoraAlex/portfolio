---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import TopNav from "../components/TopNav.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import StackSection from "../components/StackSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import GithubSection from "../components/GithubSection.astro";
import BlogSection from "../components/BlogSection.astro";
import Footer from "../components/Footer.astro";
import { flags } from "../config/flags";
---

<BaseLayout>
  <Sidebar />
  <!-- Main Content Area -->
  <main class="flex-1 lg:ml-sidebar-width flex flex-col w-full relative">
    <TopNav />
    <div class="w-full max-w-container-max mx-auto px-margin-page py-section-padding space-y-24">
      <ExperienceSection />
      <StackSection />
      {flags.featuredProjects && <ProjectsSection />}
      {flags.github && <GithubSection />}
      {flags.blog && <BlogSection />}
    </div>
    <Footer />
  </main>
</BaseLayout>
